{
  "Server": {
    "BaseUrl": "https://api.example.com"
  },
  "Auth": {
    "SigningKey": "change-this-production-signing-key",
    "TokenLifetimeHours": 12
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowMinutes": 1
  },
  "Payments": {
    "Provider": "stripe",
    "DefaultSuccessUrl": "https://app.example.com/PaymentSuccess",
    "DefaultCancelUrl": "https://app.example.com/PaymentCancel",
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": ""
    }
  },
  "ConnectionStrings": {
    "SqlServer": "Server=tcp:db.example.com,1433;Database=TrampBazaar;User Id=app;Password=replace-me;Encrypt=True;TrustServerCertificate=False;Connect Timeout=30;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
